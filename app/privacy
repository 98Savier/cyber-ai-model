import {
  consumeStream,
  convertToModelMessages,
  streamText,
  UIMessage,
} from "ai"

export const maxDuration = 30

export async function POST(req: Request) {
  const { messages, userType }: { messages: UIMessage[]; userType: string } = await req.json()

  const result = streamText({
    model: "openai/gpt-5",
    system: `You are a cybersecurity expert creating personalized security checklists. Generate a comprehensive, actionable security checklist for a ${userType}.

Format your response as a clear checklist with categories. Each item should be:
- Specific and actionable
- Prioritized (High/Medium/Low priority)
- Include brief explanation of why it matters

Categories to consider:
- Account Security
- Device Security
- Network Security
- Data Protection
- Privacy Settings
- Backup & Recovery
- Security Software

Tailor recommendations to the user type. Be thorough but practical.`,
    messages: await convertToModelMessages(messages),
    abortSignal: req.signal,
  })

  return result.toUIMessageStreamResponse({
    originalMessages: messages,
    consumeSseStream: consumeStream,
  })
}
