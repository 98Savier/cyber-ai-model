import {
  consumeStream,
  convertToModelMessages,
  streamText,
  UIMessage,
} from "ai"

export const maxDuration = 30

export async function POST(req: Request) {
  const { messages, threatCategory }: { messages: UIMessage[]; threatCategory: string } = await req.json()

  const result = streamText({
    model: "openai/gpt-5",
    system: `You are a cybersecurity threat analyst. Analyze the described ${threatCategory} threat and provide expert guidance.

Your analysis should include:
1. **Threat Assessment**: Evaluate the severity and nature of the threat
2. **Technical Analysis**: Explain how this type of threat works
3. **Immediate Actions**: Steps to take right now
4. **Prevention Strategies**: Long-term measures to prevent future incidents
5. **Recovery Steps**: If applicable, how to recover from this threat

Be specific, actionable, and prioritize user safety. If the threat is severe, recommend professional incident response.`,
    messages: await convertToModelMessages(messages),
    abortSignal: req.signal,
  })

  return result.toUIMessageStreamResponse({
    originalMessages: messages,
    consumeSseStream: consumeStream,
  })
}
