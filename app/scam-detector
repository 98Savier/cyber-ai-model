import {
  consumeStream,
  convertToModelMessages,
  streamText,
  UIMessage,
} from "ai"

export const maxDuration = 30

export async function POST(req: Request) {
  const { messages, contentType }: { messages: UIMessage[]; contentType: string } = await req.json()

  const result = streamText({
    model: "openai/gpt-5",
    system: `You are a cybersecurity expert specializing in scam detection. Analyze the provided ${contentType} content for potential scams, phishing attempts, or malicious intent.

Your analysis should include:
1. **Risk Assessment**: Rate the risk level (Low/Medium/High/Critical)
2. **Red Flags**: List any suspicious elements found
3. **Analysis Details**: Explain why each element is concerning
4. **Recommendations**: Provide actionable advice

Be thorough but concise. If the content appears legitimate, explain why it seems safe while noting any minor concerns.`,
    messages: await convertToModelMessages(messages),
    abortSignal: req.signal,
  })

  return result.toUIMessageStreamResponse({
    originalMessages: messages,
    consumeSseStream: consumeStream,
  })
}
